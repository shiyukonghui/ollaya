/target/
**/*.rs.bk

# Python build-time tooling (convert/)
.venv/
__pycache__/
*.egg-info/

# Conversion outputs and downloaded weights never go in git
/convert/out/
*.onnx
*.onnx.data
*.safetensors

# Derived registry blobs are build outputs (package.py); manifests are tracked.
/registry/blobs/

# Local NeoHorse build outputs: the GPU pack (~2 GB of NVIDIA/ONNX Runtime DLLs), a second
# bundle on disk and the local model store (hard links to the ~9 GB of weights).
/out/cuda-pack/
/out/decider-2b-vision/
/out/ollaya-models/

# Agent worktrees (Claude Code)
/.claude/worktrees/
